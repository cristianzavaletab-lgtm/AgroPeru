{
  "name": "agroperu-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.mjs",
    "dev:web": "vite --host --port 5173 --strictPort",
    "tunnel": "npx cloudflared tunnel --protocol http2 --edge-ip-version 4 --url http://localhost:5173",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "test": "npm run lint && npm run build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  }
}
