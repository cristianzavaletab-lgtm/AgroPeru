# La aplicación funciona localmente sin estas variables.
# Activa la sincronización solo cuando el proyecto Supabase esté configurado.
VITE_ENABLE_SUPABASE_SYNC=false
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica-anon
VITE_APP_STATE_ID=agroperu-main

# Base de datos usada por Prisma en procesos de servidor o migraciones.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/agroperu

# Secreto exclusivo del servidor. Nunca uses el prefijo VITE_ para este token.
DNIRUC_API_TOKEN=pega-aqui-un-token-nuevo
API_PORT=3001
